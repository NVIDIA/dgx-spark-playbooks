[Unit]
Description=OpenViking with local Ollama and NVIDIA cuVS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
UMask=0077
Environment=OPENVIKING_CONFIG_FILE=%h/.openviking/ov.conf
ExecStart=%h/.local/share/openviking-cuvs/.venv/bin/openviking-server --config %h/.openviking/ov.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
